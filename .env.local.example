# ==========================================================
# AXENTIA – Variables de entorno
# Copiá este archivo como ".env.local" y completá los valores.
# ==========================================================

# ---- Envío de correos (formulario de auditoría) ----
# Servidor y puerto SMTP de Gmail. No hace falta cambiarlos.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# La cuenta de Gmail que envía los correos.
SMTP_USER=axentia.consulting@gmail.com

# IMPORTANTE: no uses tu contraseña normal de Gmail.
# 1. Andá a https://myaccount.google.com/security
# 2. Activá la verificación en 2 pasos (si todavía no la tenés).
# 3. Buscá "Contraseñas de aplicaciones" y generá una nueva para "Correo".
# 4. Pegá esa contraseña de 16 caracteres acá (sin espacios).
SMTP_PASS=

# ---- Panel de administración (/admin) ----
# Contraseña para entrar al panel de administración.
ADMIN_PASSWORD=

# Clave secreta usada para firmar la sesión del panel de admin.
# Podés dejarla en blanco en desarrollo; en producción poné un valor propio y largo.
SESSION_SECRET=

# ---- Motor de Prospección: base de datos (Postgres) ----
# Cadena de conexión de tu base Postgres (Railway, Neon, etc.). Sacala del
# dashboard del proveedor: servicio Postgres → pestaña "Variables" → DATABASE_URL.
DATABASE_URL=

# ---- Google Calendar (disponibilidad en el panel de admin y reservas) ----
# 1. Abrí el archivo JSON descargado de la Service Account de Google.
# 2. Convertí/comprimí todo el JSON en una sola línea.
# 3. Pegá ese JSON completo como valor de abajo (entre comillas simples).
# Ejemplo: GOOGLE_SERVICE_ACCOUNT_KEY='{"type": "service_account", "project_id": "...", ...}'
GOOGLE_SERVICE_ACCOUNT_KEY=''

# ---- Motor de Prospección: búsqueda de empresas (Google Places API New) ----
# 1. En Google Cloud Console, creá (o reutilizá) un proyecto con facturación activa.
# 2. Habilitá "Places API (New)".
# 3. Creá una API key y restringila a "Places API (New)" (nunca la uses en el frontend).
GOOGLE_MAPS_API_KEY=

# ---- Motor de Prospección: argumento comercial con IA (Fase 9) ----
# API key de la consola de Claude (console.claude.com) — nunca se usa en el frontend.
ANTHROPIC_API_KEY=
# Solo necesario si tu API key es "identity-linked" (asociada a tu login, no a
# un workspace fijo) — la consola te avisa con un error 400 si hace falta.
# La encontrás en console.claude.com, en la configuración del workspace.
ANTHROPIC_WORKSPACE_ID=
# Opcional: modelo a usar (por defecto claude-opus-5).
ANTHROPIC_MODEL=claude-opus-5

# Límites diarios de uso (control de costes). Opcionales: si no se definen,
# se usan estos valores por defecto, pensados para la Fase 0 (~100 empresas).
MAX_SEARCHES_PER_DAY=20
MAX_RESULTS_PER_SEARCH=20
MAX_AUDITS_PER_DAY=40
MAX_AI_CALLS_PER_DAY=30
